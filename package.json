{
  "name": "alexa-via-airplay",
  "version": "0.1.0",
  "description": "Expose Amazon Echo speakers as AirPlay 2 receivers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "build": "pnpm --filter @alexa-via-airplay/web build",
    "dev:web": "pnpm --filter @alexa-via-airplay/web dev",
    "typecheck": "tsc && pnpm --filter @alexa-via-airplay/web typecheck",
    "test": "LOG_LEVEL=error node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "aedes": "^1.2.0",
    "alexa-remote2": "8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.12.0"
}

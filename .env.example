# alexa-via-airplay configuration: environment variables that compose.yaml
# passes to the bridge. Everything is optional; settings you change in the web
# UI live in /data.

# --- Public stream URL -------------------------------------------------------
# The bridge doesn't publish anything itself: run your own Cloudflare Tunnel or
# HTTPS reverse proxy to the public port (SETUP.md, step 1).

# The HTTPS URL that reaches the public port, e.g. https://airplay.example.com.
# Usually entered in the web UI instead; setting it here locks it.
# PUBLIC_BASE_URL=

# --- Ports -------------------------------------------------------------------
# LAN web UI and API. Never publish this port to the internet.
# UI_PORT=8098
# UI_BIND=0.0.0.0
# Public listener (only /play.mp3), on all interfaces by default. With
# cloudflared on this host (host networking), 127.0.0.1 keeps it off the LAN.
# PUBLIC_PORT=8099
# PUBLIC_BIND=0.0.0.0
# Amazon login proxy, opened in your browser while signing in.
# ALEXA_PROXY_PORT=3456
# First AirPlay port; each receiver takes the next free one.
# AIRPLAY_BASE_PORT=7000
# Internal broker for the receivers' session events (loopback only).
# EVENT_BUS_PORT=18830

# --- Who may play the stream ---------------------------------------------------
# Header carrying the client address, believed only from TRUSTED_PROXIES.
# cf-connecting-ip for Cloudflare Tunnel; x-real-ip or x-forwarded-for behind
# a reverse proxy; "none" to use the connection's own address.
# CLIENT_IP_HEADER=cf-connecting-ip
# TRUSTED_PROXIES=127.0.0.1,::1
# How the bridge learns its own public IP (must answer with an "ip=" line).
# PUBLIC_IP_TRACE_URL=https://cloudflare.com/cdn-cgi/trace
# PUBLIC_IP_REFRESH_SECONDS=300
# IPv6 clients must be in the same prefix as this host's public IPv6.
# PUBLIC_IP_V6_PREFIX=64

# --- Network -------------------------------------------------------------------
# Interfaces to announce AirPlay receivers on (default: the default route's).
# AVAHI_INTERFACES=eth0

# LOG_LEVEL=info
